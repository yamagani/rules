    "@rules/schemas": "workspace:*",
    "@rules/ui-registry": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@rules/config": "workspace:*",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10",
    "esbuild": "^0.25.0"
  }
