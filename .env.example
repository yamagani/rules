# Copy to .env (never commit it). Values here are placeholders only.

# --- rules-service ---------------------------------------------------------
ENV=local
# Pooled connection (PgBouncer on Neon) used by the running service.
DATABASE_URL=postgresql://rules:rules@localhost:5432/rules
# Direct connection, used only by Alembic migrations.
DATABASE_URL_UNPOOLED=postgresql://rules:rules@localhost:5432/rules
# Demo login (dev token issuer) outside local. Refused on VERCEL_ENV=production.
DEMO_AUTH=false
# HS256 secret for the dev token issuer (local/demo only).
DEV_JWT_SECRET=
# OIDC (production): issuer, audience and JWKS URL of Okta / Azure AD / any OIDC IdP.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=groups

# --- AI authoring (rules-service only; never set these on the BFF or web apps) ---
AI_DEFAULT_PROVIDER=mock
AI_DEFAULT_MODEL=claude-sonnet-5-5
AI_MAX_REPAIR_ATTEMPTS=2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- BFF ---------------------------------------------------------------------
RULES_SERVICE_URL=http://localhost:8000

# --- shell (build time; written into /mfe-manifest.json) ---------------------
VITE_REMOTE_RULES_URL=http://localhost:5174
VITE_REMOTE_RELEASES_URL=http://localhost:5175
VITE_REMOTE_ADMIN_URL=http://localhost:5176
